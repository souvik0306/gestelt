<?xml version="1.0"?>
<launch>

    <arg name="fcu_url" default="serial:///dev/ttyAML0:921600"/>
    <!-- <arg name="fcu_url" default="udp://:14540@localhost:14580"/> -->

    <include file="$(find mavros)/launch/px4.launch">
        <arg name="fcu_url" value="$(arg fcu_url)"/>
    </include>

    <node pkg="imu_listener_pkg"
          type="ai_imu_client_swap.py"
          name="ai_imu_client"
          output="screen"
          required="true"/>
        
    <!-- Record all ROS topics -->
    <node pkg="rosbag"
          type="record"
          name="rosbag_record"
          output="screen"
          args="-a -o $(find imu_listener_pkg)/data/flight"/>     

</launch>